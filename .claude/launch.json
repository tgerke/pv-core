{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@pv-core/api", "dev"],
      "port": 8789
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@pv-core/web", "dev"],
      "port": 5176
    },
    {
      "name": "docs-site",
      "runtimeExecutable": "/bin/bash",
      "runtimeArgs": ["-c", "pnpm --filter site dev --port ${PORT:-4322}"],
      "port": 4322,
      "autoPort": true
    }
  ]
}

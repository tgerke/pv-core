# Postgres from docker-compose.yml — owning role, used by migrations and seed.
DATABASE_URL=postgres://pv:pv@localhost:5436/pv
# The API itself always connects as the least-privilege pv_app role
# (derived from DATABASE_URL; override with DATABASE_URL_APP or
# PV_APP_PASSWORD after rotating the role password in production).
# apps/api
API_PORT=8789

# Regulatory clocks are calendar days in the sponsor's business time zone
# (ADR-0007). Every connection sets this session TimeZone; the digest and
# on-time metrics cast instants to dates with it.
PV_TIMEZONE=America/New_York

# Blob storage for source documents and submission payloads (ADR-0013):
# 'local' (dev directory, default) or 's3' (any S3-compatible store; with
# Object Lock on the bucket, the bytes become WORM).
STORAGE_DRIVER=local
# S3_ENDPOINT=http://localhost:9002   # MinIO from docker-compose
# S3_REGION=us-east-1
# S3_BUCKET=pv-attachments
# S3_ACCESS_KEY_ID=pvminio
# S3_SECRET_ACCESS_KEY=pv-minio-dev
# S3_FORCE_PATH_STYLE=true            # required for MinIO
# S3_OBJECT_LOCK_MODE=COMPLIANCE      # omit to use the bucket's default rule
# S3_OBJECT_LOCK_RETENTION_DAYS=3650

# Authentication mode: 'dev' (static tokens below, demo only) or 'oidc'.
# The API refuses to start without an explicit mode.
AUTH_MODE=dev
# dev-only bearer tokens, see docs/04-api.md; each maps to a seeded person
API_TOKEN_ADMIN=dev-admin-token
API_TOKEN_PROCESSOR=dev-processor-token
API_TOKEN_REVIEWER=dev-reviewer-token
API_TOKEN_READONLY=dev-readonly-token
# machine identity for source-system intake (EDC -> PV); enter-only
API_TOKEN_INGEST=dev-ingest-token

# Reminders digest (ADR-0014): `pnpm digest` reads the derived views and
# emails due-soon/overdue obligations to the people holding study-wide
# grants. Stateless — schedule it with cron or your platform's scheduler.
# SMTP_URL=smtp://localhost:1026          # mailpit from docker-compose (dev)
# DIGEST_FROM=pv-core digest <digest@corc.example>
# DIGEST_TO=you@example.org               # optional: override derived recipients

# AUTH_MODE=oidc — validate bearer JWTs from a real identity provider.
# Works with any OIDC-compliant IdP (Okta, Entra ID, Auth0, Keycloak, ...).
# OIDC_ISSUER=https://idp.example.com/realms/clinical
# OIDC_AUDIENCE=pv-api
# OIDC_JWKS_URI=            # optional; defaults to the issuer's discovery document
# OIDC_EMAIL_CLAIM=email    # claim that maps the token to a person record
# Machine identities (client-credentials tokens carry no email claim):
# map token subjects to provisioned person records, comma-separated.
# API_SERVICE_SUBJECTS=edc-intake-client:edc.intake@corc.example
# REAUTH_MAX_AGE_SECONDS=300  # §11.200 signing re-auth freshness window

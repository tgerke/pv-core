---
// A screenshot with an optional visible caption. Plain markdown images stay the
// default in prose pages; use this in MDX when the takeaway deserves a caption or
// the image needs responsive widths. Sources come from tools/screenshots.mjs.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  priority?: boolean;
}

const { src, alt, caption, priority = false } = Astro.props;
const widths = [720, 1440, 2880].filter((w) => w <= src.width);
if (widths.length === 0) widths.push(src.width);
---

<figure class="pv-shot">
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes="(min-width: 50rem) 45rem, calc(100vw - 2rem)"
    loading={priority ? "eager" : "lazy"}
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .pv-shot {
    margin: 1.25rem 0;
  }
  .pv-shot figcaption {
    margin-top: 0.55rem;
    font-size: var(--sl-text-sm);
    line-height: 1.5;
    color: var(--sl-color-gray-3);
  }
</style>

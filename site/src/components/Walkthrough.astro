---
// A step-by-step tour of screenshots. Server HTML is a plain numbered list of
// figures (readable without JavaScript, in print, and by search); the script
// turns it into one step at a time with Previous/Next, numbered dots, arrow
// keys, deep links (#step-id), and a "Show all steps" toggle that persists.
interface Props {
  id: string;
  label?: string;
}

const { id, label = "Walkthrough" } = Astro.props;
---

<section class="pv-walk" id={id} data-walk aria-label={label}>
  <div class="pv-walk__bar not-content" data-walk-bar data-pagefind-ignore hidden>
    <div class="pv-walk__nav">
      <button type="button" data-walk-prev>Previous</button>
      <ol class="pv-walk__dots" data-walk-dots aria-label="Steps"></ol>
      <button type="button" data-walk-next>Next</button>
    </div>
    <p class="pv-walk__counter" data-walk-counter aria-live="polite"></p>
    <button type="button" class="pv-walk__all" data-walk-all aria-pressed="false">
      Show all steps
    </button>
  </div>
  <ol class="pv-walk__steps" data-walk-steps><slot /></ol>
</section>
<script is:inline>
  // Before first paint: hide every step but the first unless the reader chose
  // "show all" earlier, so the page never flashes the whole list.
  (function (s) {
    try {
      if (localStorage.getItem("pv-walk:mode") !== "all")
        s.previousElementSibling.classList.add("is-js");
    } catch (e) {}
  })(document.currentScript);
</script>

<script>
  const MODE = "pv-walk:mode";
  for (const root of document.querySelectorAll<HTMLElement>("[data-walk]")) {
    const steps = [
      ...root.querySelectorAll<HTMLElement>(":scope > [data-walk-steps] > [data-walk-step]"),
    ];
    if (steps.length < 2) {
      root.classList.remove("is-js");
      continue;
    }
    const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel) as T;
    const bar = q("[data-walk-bar]");
    const prev = q<HTMLButtonElement>("[data-walk-prev]");
    const next = q<HTMLButtonElement>("[data-walk-next]");
    const all = q<HTMLButtonElement>("[data-walk-all]");
    const dots = q("[data-walk-dots]");
    const counter = q("[data-walk-counter]");
    let i = 0;
    let showAll = false;
    try {
      showAll = localStorage.getItem(MODE) === "all";
    } catch {}

    steps.forEach((s, n) => {
      const li = document.createElement("li");
      const b = document.createElement("button");
      b.type = "button";
      b.textContent = String(n + 1);
      b.setAttribute("aria-label", `Step ${n + 1}: ${s.dataset.stepTitle ?? ""}`);
      b.addEventListener("click", () => go(n));
      li.append(b);
      dots.append(li);
    });

    function render() {
      root.classList.toggle("is-all", showAll);
      steps.forEach((s, n) => {
        s.hidden = !showAll && n !== i;
        s.classList.toggle("is-current", n === i);
      });
      prev.disabled = i === 0;
      next.disabled = i === steps.length - 1;
      counter.textContent = `Step ${i + 1} of ${steps.length}`;
      all.setAttribute("aria-pressed", String(showAll));
      all.textContent = showAll ? "One step at a time" : "Show all steps";
      dots
        .querySelectorAll("button")
        .forEach((b, n) => b.setAttribute("aria-current", n === i ? "step" : "false"));
    }
    function go(n: number, focus = true) {
      i = Math.max(0, Math.min(steps.length - 1, n));
      render();
      history.replaceState(null, "", `#${steps[i].id}`);
      if (root.getBoundingClientRect().top < 0) root.scrollIntoView({ block: "start" });
      if (focus) steps[i].focus({ preventScroll: true });
    }
    function fromHash() {
      const target = location.hash && document.getElementById(location.hash.slice(1));
      const k = target ? steps.findIndex((s) => s === target || s.contains(target)) : -1;
      if (k >= 0) i = k;
      return k >= 0;
    }

    prev.addEventListener("click", () => go(i - 1));
    next.addEventListener("click", () => go(i + 1));
    all.addEventListener("click", () => {
      showAll = !showAll;
      try {
        localStorage.setItem(MODE, showAll ? "all" : "step");
      } catch {}
      render();
    });
    root.addEventListener("keydown", (e) => {
      if (showAll) return;
      if (e.key === "ArrowRight") {
        e.preventDefault();
        go(i + 1);
      } else if (e.key === "ArrowLeft") {
        e.preventDefault();
        go(i - 1);
      }
    });
    window.addEventListener("hashchange", () => {
      if (fromHash()) render();
    });

    fromHash();
    bar.hidden = false;
    root.classList.remove("is-js");
    root.classList.add("is-ready");
    render();
    if (location.hash && steps[i].id === location.hash.slice(1)) {
      steps[i].scrollIntoView({ block: "start" });
    }
  }
</script>

<style is:global>
  .pv-walk__steps {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: walk;
  }
  .pv-walk__step {
    counter-increment: walk;
    padding-top: 0.5rem;
    outline: none;
  }
  .pv-walk__step[hidden] {
    display: none;
  }
  .pv-walk.is-js .pv-walk__step:not(:first-child) {
    display: none;
  }
  .pv-walk__step + .pv-walk__step {
    margin-top: 2.5rem;
    border-top: 1px solid var(--sl-color-gray-5);
  }
  .pv-walk.is-ready:not(.is-all) .pv-walk__step + .pv-walk__step {
    margin-top: 0;
    border-top: 0;
  }
  .pv-walk__title {
    font-size: var(--sl-text-h4);
    line-height: 1.3;
  }
  .pv-walk__title::before {
    content: counter(walk) ". ";
    color: var(--sl-color-gray-3);
  }
  .pv-walk__figure {
    margin: 1rem 0 0;
  }
  .pv-walk__body > :first-child {
    margin-top: 1rem;
  }
  .pv-walk__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    position: sticky;
    top: calc(var(--sl-nav-height) + 0.5rem);
    z-index: 2;
    margin-bottom: 1rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.6rem;
    background: var(--pv-surface);
    box-shadow: 0 1px 3px rgb(0 0 0 / 8%);
  }
  .pv-walk__nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .pv-walk__bar button {
    font: inherit;
    font-size: var(--sl-text-sm);
    line-height: 1.2;
    padding: 0.35rem 0.7rem;
    border-radius: 0.4rem;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
    cursor: pointer;
  }
  .pv-walk__bar button:hover:not(:disabled) {
    border-color: var(--sl-color-gray-3);
  }
  .pv-walk__bar button:disabled {
    opacity: 0.45;
    cursor: default;
  }
  .pv-walk__dots {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pv-walk__dots li {
    margin: 0;
  }
  .pv-walk__dots button {
    min-width: 2rem;
    padding-inline: 0.45rem;
  }
  .pv-walk__dots button[aria-current="step"] {
    background: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
    color: #ffffff;
  }
  .pv-walk__counter {
    margin: 0 0 0 auto;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    white-space: nowrap;
  }
  .pv-walk.is-all .pv-walk__nav,
  .pv-walk.is-all .pv-walk__counter {
    display: none;
  }
  @media print {
    .pv-walk__bar {
      display: none;
    }
    .pv-walk__step[hidden] {
      display: list-item;
    }
  }
</style>
